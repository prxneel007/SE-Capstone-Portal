digraph ER {
  graph [rankdir=LR, fontname="Helvetica", pad=0.3, nodesep=0.4, label="Capstone Hub - Entity relationship diagram", labelloc=t, fontsize=18];
  node [shape=plain, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9, color="#555", arrowhead=crow, arrowtail=tee, dir=both];
  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#2f5bd3"><font color="white"><b>users</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">name, email UNIQUE, srn</td></tr><tr><td align="left">password_hash</td></tr><tr><td align="left">role (student|faculty|admin)</td></tr></table>>];
  ideas [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#2f5bd3"><font color="white"><b>ideas</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">title, description</td></tr><tr><td align="left">domain, tags</td></tr><tr><td align="left">author_id FK</td></tr></table>>];
  votes [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#2f5bd3"><font color="white"><b>votes</b></font></td></tr><tr><td align="left">user_id PK,FK</td></tr><tr><td align="left">idea_id PK,FK</td></tr></table>>];
  teams [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#2f5bd3"><font color="white"><b>teams</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">name UNIQUE, invite_code UNIQUE</td></tr><tr><td align="left">idea_id FK UNIQUE</td></tr><tr><td align="left">mentor_id FK, created_by FK</td></tr></table>>];
  members [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#2f5bd3"><font color="white"><b>team_members</b></font></td></tr><tr><td align="left">team_id PK,FK</td></tr><tr><td align="left">user_id PK,FK UNIQUE</td></tr></table>>];
  milestones [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#2f5bd3"><font color="white"><b>milestones</b></font></td></tr><tr><td align="left">id PK, team_id FK</td></tr><tr><td align="left">title, description</td></tr><tr><td align="left">due_date, status</td></tr></table>>];
  submissions [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#2f5bd3"><font color="white"><b>submissions</b></font></td></tr><tr><td align="left">id PK, team_id FK</td></tr><tr><td align="left">milestone_id FK</td></tr><tr><td align="left">filename, stored_name, text_content</td></tr><tr><td align="left">similarity, similar_to FK, version</td></tr><tr><td align="left">submitted_by FK</td></tr></table>>];
  feedback [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#2f5bd3"><font color="white"><b>feedback</b></font></td></tr><tr><td align="left">id PK, submission_id FK</td></tr><tr><td align="left">faculty_id FK</td></tr><tr><td align="left">comment, grade</td></tr></table>>];
  notifications [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#2f5bd3"><font color="white"><b>notifications</b></font></td></tr><tr><td align="left">id PK, user_id FK</td></tr><tr><td align="left">message, link, is_read</td></tr><tr><td align="left">dedupe_key UNIQUE</td></tr></table>>];
  users -> ideas [label="authors"]; users -> votes; ideas -> votes; users -> members [label="belongs (0..1)"]; teams -> members [label="has (1..4)"];
  ideas -> teams [label="claimed by (0..1)", arrowhead=teeodot]; users -> teams [label="mentors"]; teams -> milestones; teams -> submissions; milestones -> submissions;
  submissions -> feedback; users -> feedback [label="writes"]; users -> notifications;
}
